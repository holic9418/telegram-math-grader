# 이 파일을 복사해서 .env 라는 이름으로 만들고, 아래 값을 채워 넣으세요.
# (실제 .env 파일은 절대 GitHub 등에 올리지 마세요.)

TELEGRAM_BOT_TOKEN=여기에_BotFather에서_받은_봇_토큰
ANTHROPIC_API_KEY=여기에_Anthropic_API_키

# (선택) 출석부 데이터 저장 폴더. Railway 영구 볼륨을 쓸 땐 /data 로 지정.
# 로컬에서는 비워두면 ./data 폴더에 저장됩니다.
DATA_DIR=

# (선택) 사용할 Claude 모델. 비워두면 claude-opus-4-8.
CLAUDE_MODEL=

# (선택) 과목. math / english / korean. 비워두면 math(수학).
# 과목마다 봇 토큰·볼륨·SUBJECT를 다르게 배포하면 같은 코드로 여러 과목 운영 가능.
SUBJECT=

# (선택) 관리자 chat_id 강제 지정. 보통은 봇에 '관리자등록'으로 정함.
ADMIN_CHAT_ID=
